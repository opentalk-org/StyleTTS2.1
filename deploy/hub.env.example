# Hub (Vast.ai) runtime env — copy to ../.env at the repo root, fill in, then:
#
#   docker run -d --name runflow-hub \
#     --gpus all \
#     -v runflow-data:/data \
#     --env-file .env \
#     ghcr.io/<owner>/runflow-studio:latest      # (or the locally loaded hub image tag)
#
# The hub uses USERSPACE tailscale (Vast.ai containers have no /dev/net/tun) and
# publishes PgBouncer/NATS/RustFS to the tailnet with `tailscale serve --tcp`
# (raw passthrough). No --cap-add / --device needed. Service ports are not
# published to the host — only tailnet peers reach them.

# --- Headscale / Tailscale (required to join the tailnet) --------------------
TAILSCALE_LOGIN_SERVER=https://headscale.yourdomain.com
TAILSCALE_AUTHKEY=                 # Headscale reusable pre-auth key
TAILSCALE_HOSTNAME=runflow-hub     # the name runners dial (RUNFLOW_HUB_HOST)
TAILSCALE_TAGS=tag:vast            # optional; only if your Headscale ACL uses tags

# --- Credentials (leave default for a private tailnet; change for prod) ------
# If you change these, set the SAME values as GitHub secrets so the Salad runners
# (which log into this hub's Postgres/S3) match.
# POSTGRES_PASSWORD=runflow
# RUSTFS_SECRET_KEY=runflow-secret
